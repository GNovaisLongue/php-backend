# URL=http://localhost:3000
URL=

DB_TYPE=mysql # mysql | pgsql

# Canonical keys (also accepts legacy MYSQL_DB_* aliases in App/Config/config.php)
MYSQL_DATABASE=ecommerce_products
MYSQL_HOST=mysql # docker db service name | 127.0.0.1 | localhost
MYSQL_USER=mysql
MYSQL_PASSWORD=root
MYSQL_ROOT_PASSWORD=root
MYSQL_DB_CHARSET=utf8mb4 # should stay like this
